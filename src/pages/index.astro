---
import Layout from "../layouts/Layout.astro";

const services = [
	{
		title: "Admin & Transaction Support",
		blurb:
			"Process-driven document handling and checklist tracking, with a QA background for careful, repeatable work.",
	},
	{
		title: "Listings & Marketing",
		blurb: "Building and updating landing pages and listing materials with consistent, repeatable processes.",
	},
	{
		title: "Lead & CRM Management",
		blurb: "Structured data handling to keep lead and follow-up pipelines accurate and up to date.",
	},
	{
		title: "Tech Support",
		blurb: "Troubleshooting and debugging when your tools break — not just following a script.",
	},
];

const samples = [
	"Property landing page",
	"Flyers & social posts",
	"Lead follow-up email sequence",
	"Transaction tracker",
	"Automation demo",
	"Market report template",
];
---

<Layout>
	<!-- Hero -->
	<section class="mx-auto w-full max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
		<p class="font-mono text-sm text-indigo">Real Estate Virtual Assistant</p>
		<h1 class="mt-3 max-w-3xl text-hero font-bold text-text">
			A Real Estate VA Who Can Actually Fix Your Tech Stack
		</h1>
		<p class="mt-6 max-w-prose text-lg text-muted">
			I'm Vincent — a full-stack software engineer who spent 3+ years building and testing
			enterprise systems for Japanese insurance companies, including working on-site in Japan.
			Now I bring that same precision to real estate admin, transaction support, listings, and CRM
			work — so you get a VA who doesn't just follow a checklist, but actually understands how your
			tools work and can fix things when they break.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a
				href="/contact"
				class="rounded-md bg-teal px-5 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
			>
				Book a Call
			</a>
			<a
				href="/portfolio"
				class="rounded-md border border-border px-5 py-3 text-sm font-semibold text-text transition-colors hover:border-teal hover:text-teal"
			>
				See the Work
			</a>
		</div>
	</section>

	<!-- Service highlights -->
	<section class="border-t border-border bg-surface">
		<div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<h2 class="text-2xl font-bold text-text sm:text-3xl">Where I Fit In</h2>
				<a
					href="/services"
					class="text-sm font-semibold text-teal transition-opacity hover:opacity-80"
				>
					See all services →
				</a>
			</div>
			<div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
				{
					services.map((service) => (
						<div class="rounded-lg border border-border bg-surface-2 p-6">
							<h3 class="font-heading text-lg font-semibold text-text">{service.title}</h3>
							<p class="mt-2 text-sm text-muted">{service.blurb}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Featured samples teaser -->
	<section class="border-t border-border">
		<div class="mx-auto w-full max-w-6xl px-5 py-16 sm:px-8">
			<div class="flex flex-wrap items-end justify-between gap-4">
				<div>
					<h2 class="text-2xl font-bold text-text sm:text-3xl">Sample Work</h2>
					<p class="mt-2 max-w-prose text-sm text-muted">
						Samples built to demonstrate capability, not real client work.
					</p>
				</div>
				<a href="/portfolio" class="text-sm font-semibold text-teal transition-opacity hover:opacity-80">
					View portfolio →
				</a>
			</div>
			<ul class="mt-8 flex flex-wrap gap-3">
				{
					samples.map((sample) => (
						<li class="rounded-full border border-border bg-surface px-4 py-2 font-mono text-sm text-muted">
							{sample}
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Closing CTA -->
	<section class="border-t border-border bg-surface">
		<div
			class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-6 px-5 py-16 sm:px-8 md:flex-row md:items-center"
		>
			<div>
				<h2 class="text-2xl font-bold text-text sm:text-3xl">Let's talk about your business</h2>
				<p class="mt-2 max-w-prose text-muted">
					Tell me what's slowing you down, and I'll show you how I can help.
				</p>
			</div>
			<a
				href="/contact"
				class="shrink-0 rounded-md bg-teal px-6 py-3 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
			>
				Book a Call
			</a>
		</div>
	</section>
</Layout>
